# Installed inside the image by `npm ci` — copying the host's copy would be slow and
# can carry platform-specific native binaries.
node_modules/

# Build output, regenerated during the image build.
.next/
out/

# Local environment files. Critical: .env.local would otherwise be baked into the
# image and could shadow the NEXT_PUBLIC_API_URL passed as a build-arg.
.env
.env.local
.env.*.local

.git/
.vscode/
.DS_Store
npm-debug.log*
