<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Swashbuckle reads the XML comments to enrich the generated OpenAPI document. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 = "missing XML comment for publicly visible type or member". -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Enables `dotnet user-secrets set "Jwt:Secret" ...` so the signing key never lands in a committed file. -->
    <UserSecretsId>assignmenthub-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssignmentHub.Application\AssignmentHub.Application.csproj" />
    <ProjectReference Include="..\AssignmentHub.Infrastructure\AssignmentHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <!--
      Design-time only: `dotnet ef` needs this in the *startup* project. It is not
      shipped with the app, hence PrivateAssets="all".
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
