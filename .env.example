# -----------------------------------------------------------------------------
# Assignment Hub - example environment configuration
#
# Copy this file and fill in real values. Nothing here is a working credential.
#   cp .env.example .env
#
# Backend  : ASP.NET Core reads environment variables with "__" as the section
#            separator, so Jwt__Secret maps to the Jwt:Secret setting.
#            Locally you can instead use user-secrets:
#              cd backend/src/AssignmentHub.Api
#              dotnet user-secrets set "Jwt:Secret" "<your 32+ character key>"
# Frontend : Next.js only reads frontend/.env.local, so copy the
#            NEXT_PUBLIC_* line there as well.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# Must match docker-compose.yml when using the bundled Postgres container.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=assignmenthub;Username=assignmenthub;Password=change-me

# --- Authentication ----------------------------------------------------------
# Minimum 32 characters (256 bits) - HMAC-SHA256 rejects anything shorter.
# Generate one with: openssl rand -base64 48
Jwt__Secret=replace-with-a-32-character-minimum-random-secret
Jwt__Issuer=AssignmentHub
Jwt__Audience=AssignmentHubClient

# --- Frontend ----------------------------------------------------------------
# Base URL of the API, as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:5080
